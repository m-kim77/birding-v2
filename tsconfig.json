{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // api/가 src/의 파일을 불러온다. Vercel은 .ts 파일을 .js로 바꿔 올리므로 import 경로의 .ts도 .js로 바꿔야 배포된 함수가 파일을 찾는다
    // (끄면 로컬은 되고 배포에서만 함수가 뜨지 않는다 — 2026-09-27 Vercel 빌더로 확인)
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "scripts",
    "test",
    "api",
    "vite.config.ts",
    "dev"
  ]
}