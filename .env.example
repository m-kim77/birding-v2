# 기본 제공 AI(운영자의 로컬 LLM) 연결. Vercel에서는 프로젝트 환경변수로 넣는다 — 이 값들은 브라우저로 나가지 않는다.
# 로컬 개발: 이 파일을 .env.local 로 복사해서 쓴다 (.env* 는 git에 올라가지 않는다).
LOCAL_LLM_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_KEY=
LOCAL_LLM_MODEL=qwen3.8-flash-next
# 한 턴의 토큰 상한 (생각 토큰 포함). 생각이 긴 모델이 답을 못 내고 끊기면 올린다. 기본 4096
# LOCAL_LLM_MAX_TOKENS=4096
# 판정 서버가 첫 응답(스트림의 첫 조각)을 줄 때까지 기다리는 초. 넘으면 "판정 서버가 바쁩니다"로 끝낸다. 기본 90
# (앞 요청이 밀려 함수가 300초를 붙잡지 않게 — 모델을 처음 올리는 데 이보다 오래 걸리면 올린다)
# LOCAL_LLM_FIRST_RESPONSE_SECONDS=90
# 생각(reasoning) 세기: low·medium·high·xhigh. 기본 low (작업 21 — 서버 기본 high보다 빠르고 판정은 나쁘지 않았다).
# server로 두면 보내지 않는다(LLM 서버의 기본값) — 이 옵션을 모르는 서버로 바꿨을 때. 바꾸면 LLM 서버가 앞부분을 한 번 새로 계산한다
# LOCAL_LLM_REASONING_EFFORT=low

# 구글 드라이브 동기화 (api/drive.ts). 셋 다 있어야 설정 화면에 드라이브 카드가 보인다. 이 값들도 브라우저로 나가지 않는다.
# 구글 클라우드 콘솔 → Google 인증 플랫폼 → 클라이언트(웹 애플리케이션). 승인된 JavaScript 원본에 실제 사이트 주소와 개발 서버 주소를 넣는다
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# 로그인 열쇠(갱신권)를 쿠키에 잠가 두는 키 — openssl rand -base64 32 로 만든다. 바꾸면 모든 사용자가 한 번 다시 로그인해야 한다
# DRIVE_COOKIE_KEY=
