# 기본 제공 AI(운영자의 로컬 LLM) 연결. Vercel에서는 프로젝트 환경변수로 넣는다 — 이 값들은 브라우저로 나가지 않는다.
# 로컬 개발: 이 파일을 .env.local 로 복사해서 쓴다 (.env* 는 git에 올라가지 않는다).
LOCAL_LLM_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_KEY=
LOCAL_LLM_MODEL=qwen3.8-flash-next
# 한 턴의 토큰 상한 (생각 토큰 포함). 생각이 긴 모델이 답을 못 내고 끊기면 올린다. 기본 4096
# LOCAL_LLM_MAX_TOKENS=4096
# 판정 서버가 첫 응답(스트림의 첫 조각)을 줄 때까지 기다리는 초. 넘으면 "판정 서버가 바쁩니다"로 끝낸다. 기본 90
# (앞 요청이 밀려 함수가 300초를 붙잡지 않게 — 모델을 처음 올리는 데 이보다 오래 걸리면 올린다)
# LOCAL_LLM_FIRST_RESPONSE_SECONDS=90
